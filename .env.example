# ==============================================================
# MEDORA CONSULT — Environment Configuration
# Copy this file to ".env" in the project root and fill in values.
# The server loads this single root .env for both dev and prod.
# ==============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list is NOT needed — this app is same-origin only
# (Express serves the React build directly, so no CORS config exists).

# --- JWT (server-issued session tokens, separate from Firebase ID tokens) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Bootstrapped Master Admin (auto-provisioned on server boot) ---
MASTER_ADMIN_EMAIL=admin@medora.com
MASTER_ADMIN_PASSWORD=ChangeThisPassword123!
MASTER_ADMIN_FULLNAME=Medora System Administrator
MASTER_ADMIN_PHONE=+233000000000

# --- Firebase Admin SDK ---
# Option A: place a real service account file at
#   server/firebase-service-account.json
# and leave the three FIREBASE_* variables below blank.
#
# Option B: no file present — the three variables below are used instead.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key with literal \n sequences for line breaks — the
# loader converts them to real newlines automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Web API Key from Firebase Console > Project Settings > General.
# Required because the Admin SDK cannot verify passwords directly — the
# login endpoint uses Firebase's REST sign-in API for that one step.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# --- Firebase Client SDK (public config, safe to expose in the browser) ---
# Used only for the doctor dashboard's real-time appointment listener.
# Find these in Firebase Console > Project Settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# --- MoMo (manual mobile money payment — no payment gateway integration) ---
# Shown on the guest booking confirmation screen with transfer instructions.
# Payment itself is verified manually by an admin, not automatically.
MOMO_NUMBER=055-000-0000
MOMO_NAME=Medora Consult
# Full URL of the Access Portal, used in the SMS/email sent once an admin
# authorizes payment. Point this at your deployed domain in production.
PUBLIC_ACCESS_URL=http://localhost:5173/access

# --- Email (booking confirmation with consultation access PIN) ---
# Any standard SMTP provider works (e.g. SendGrid, Mailgun, Amazon SES,
# Gmail with an app password). If left blank, emails are logged to the
# console instead of sent (dry-run) — SMS delivery is unaffected either way.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=apikey
EMAIL_SMTP_PASS=your-smtp-password
EMAIL_FROM="Medora Consult <no-reply@medoraconsult.com>"

# --- Agora (video consultations) ---
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_TOKEN_EXPIRY_SECONDS=3600

# --- Arkesel (SMS notifications to doctors) ---
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=Medora
